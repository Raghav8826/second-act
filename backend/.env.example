# Copy this file to .env. Keep .env out of Git and public downloads.
# Use the database connection address from your FalkorDB Cloud dashboard.
FALKORDB_URL=falkor://falkordb@YOUR_DATABASE_HOST:YOUR_PORT

# Put the DATABASE password here, not your FalkorDB website login password.
FALKORDB_PASSWORD=""

# auto follows the supplied URL: falkor/redis = plain; falkors/rediss = TLS.
# Use true only if the Cloud connection settings specify TLS.
FALKORDB_TLS=auto
FALKORDB_GRAPH=second_act

# Gemini API key from Google AI Studio. Keep it only in the private .env.
# Use a Free Tier project for the initial demo; account quotas still apply.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.1-flash-lite
